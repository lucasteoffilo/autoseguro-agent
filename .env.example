# Copie para `.env` (ignorado pelo git) e preencha. NUNCA commite a chave.
# Lido por `make smoke-llm` e, depois, pelo agente. Sem chave, `make smoke-llm-dry` roda o encanamento com um LLM de mentira,
# e os testes (`make test`) nunca leem este arquivo: o mock e o default deles.
#
# A camada de LLM nao depende de um provedor. O default e o OpenRouter (D4 no README).

# openrouter (default) | openai_compat (qualquer servidor chat-completions) | anthropic (ClaudeLLM, API direta da Anthropic)
LLM_PROVIDER=openrouter

# Chave do provedor escolhido. Para o OpenRouter tambem vale OPENROUTER_API_KEY no lugar desta.
LLM_API_KEY=

# Default do openrouter: https://openrouter.ai/api/v1. Obrigatoria para openai_compat. Fora de localhost, so https.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ALVO do smoke, nao escolha: quem decide e o smoke, pelo criterio de sempre. Serve qualquer modelo com saida estruturada que passe no
# `make llm-ping` e no `make smoke-llm`. Endpoints gratuitos OSCILAM (o alvo anterior, nvidia/nemotron-3-super-120b-a12b:free, ficou fora do ar
# em 2026-10-20): ao trocar, valide com `make llm-ping`, que custa 1 requisicao. Limite do free tier: 20 req/min e 50/dia.
LLM_MODEL=dots-studio/dots-3-note-preview:free

# Opcionais. Os valores abaixo ja sao o default para o OpenRouter.
# LLM_STRUCTURED_OUTPUT=json_schema   # json_schema | none. Use `none` se o modelo escolhido nao suportar; a validacao local vale nos dois casos.
# LLM_REASONING_EFFORT=none           # none | minimal | low | medium | high | off (off = nao envia o campo)
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT_S=6
# LLM_TEMPERATURE=

# So para LLM_PROVIDER=anthropic. NUNCA e enviada a outro provedor, e a chave do OpenRouter (sk-or-) nunca passa pelo ClaudeLLM.
# ANTHROPIC_API_KEY=
